rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /circles/{circleId}/documents/{docId}/{fileName} {
      allow read: if request.auth != null &&
        firestore.exists(/databases/ai-studio-cerchiodicura-bcc7ad81-99af-460d-9586-f50a5e71d2e2/documents/circles/$(circleId)/members/$(request.auth.uid));
      allow write: if request.auth != null &&
        firestore.exists(/databases/ai-studio-cerchiodicura-bcc7ad81-99af-460d-9586-f50a5e71d2e2/documents/circles/$(circleId)/members/$(request.auth.uid)) &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/jpeg|image/jpg|image/png');
    }
  }
}
